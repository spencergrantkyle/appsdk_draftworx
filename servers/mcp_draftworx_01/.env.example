# Draftworx MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Draftworx OAuth Configuration
AUTH_SERVER_URL=https://login.cloud.draftworx.com
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here
CLIENT_SCOPE=openid profile email api

# Draftworx API Configuration
API_SERVER_URL=https://api.cloud.draftworx.com
DRAFTWORX_PRACTICE_ID=your-practice-guid-here
DRAFTWORX_CLIENT_ID=your-client-guid-here
DRAFTWORX_FINANCIALYEAR_ID=your-financial-year-guid-here

# Security
COOKIE_ENCRYPTION_KEY=your-random-256-bit-key-here

# Server Configuration (optional)
PORT=8000
HOST=0.0.0.0
